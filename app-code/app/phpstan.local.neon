includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - Modules
        - routes
        - config
        - database
        - tests
    level: 5
    treatPhpDocTypesAsCertain: true
    ignoreErrors:
        -
            message: "#Called 'env' outside of the config directory which returns null when the config is cached, use 'config'.#"
            path: Modules/*/config/*.php
        -
            message: '#PHPDoc tag @SuppressWarnings has invalid value \(\(PHPMD\.UnusedFormalParameter\)\):.*#'
            path: app/Models/Users/User.php
        -
            message: '#PHPDoc tag @SuppressWarnings has invalid value \(\(PHPMD\.UnusedFormalParameter\)\):.*#'
            path: app/Filament/Auth/Http/Responses/LoginResponse.php
