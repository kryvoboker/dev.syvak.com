{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=25.6.1"
    },
    "author": {
        "name": "Roman Kryvobok",
        "email": "fast.kamaz@gmail.com"
    },
    "scripts": {
        "build": "cross-env NODE_ENV=production vite build",
        "dev": "DEBUG=vite:* vite",
        "ts:check": "biome check . && tsc --noEmit -p tsconfig.json",
        "ts:fix": "biome check --write .",
        "ts:format": "biome format --write .",
        "ts:lint": "biome lint .",
        "ts:typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.2",
        "@iconify-json/tabler": "^1.2.33",
        "@iconify/json": "^2.2.468",
        "@iconify/tailwind4": "^1.2.3",
        "@tailwindcss/postcss": "^4.2.4",
        "@tailwindcss/vite": "^4.2.4",
        "@types/fancybox": "^3.5.7",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^25.6.0",
        "@types/nouislider": "^15.0.0",
        "@types/wnumb": "^1.2.3",
        "cross-env": "^10.1.0",
        "knip": "^6.24.0",
        "laravel-vite-plugin": "^3.1.0",
        "postcss": "^8.5.12",
        "sass-embedded": "^1.99.0",
        "tailwindcss": "^4.2.4",
        "typescript": "^6.0.3",
        "vite": "^8.0.10",
        "vite-plugin-ts": "^1.3.2-1"
    },
    "dependencies": {
        "@fancyapps/ui": "^6.1.14",
        "choices.js": "^11.2.3",
        "flyonui": "^2.4.1",
        "leaflet": "^1.9.4",
        "leaflet-search": "^4.0.0",
        "leaflet.markercluster": "^1.5.3",
        "nouislider": "^15.8.1",
        "wnumb": "^1.2.0"
    }
}
