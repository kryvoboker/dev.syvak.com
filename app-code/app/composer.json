{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Roman Kryvobk",
            "email": "fast.kamaz@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "ext-pdo": "*",
        "bezhansalleh/filament-shield": "^4.2.0",
        "filament/filament": "^v5.6.1",
        "intervention/image-laravel": "^4.0.0",
        "laravel-lang/lang": "^15.29.3",
        "laravel/framework": "^v13.7.0",
        "laravel/tinker": "^v3.0.2",
        "livewire/livewire": "^v4.2.4",
        "mobiledetect/mobiledetectlib": "^4.10.0",
        "nwidart/laravel-modules": "^v13.0.0",
        "nyholm/psr7": "^1.8.2",
        "openai-php/client": "^v0.19.2",
        "spatie/laravel-data": "^4.22.1",
        "spatie/laravel-permission": "^7.4.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^v4.2.8",
        "fakerphp/faker": "^v1.24.1",
        "larastan/larastan": "^v3.9.6",
        "laravel/boost": "^v2.4.6",
        "laravel/pail": "^v1.2.6",
        "laravel/pint": "^v1.29.1",
        "laravel/sail": "^v1.58.0",
        "laravel/telescope": "^v5.20.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^v8.9.4",
        "phpmd/phpmd": "^2.5",
        "phpunit/phpunit": "^13.1.7",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan lang:update",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "psalm": "php -d memory_limit=1G /usr/local/bin/psalm app routes config database tests Modules",
        "phpmd": "phpmd app,routes,config,database,tests,Modules text phpmd.xml",
        "phpcs": "phpcs --standard=phpcs.xml app routes config database tests Modules",
        "phpcs:fix": "phpcbf --standard=phpcs.xml app routes config database tests Modules"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "merge-dev": true
        },
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
